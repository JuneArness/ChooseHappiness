# Copy to .env.local for local development, and add the same values in your hosting provider's settings.
# These two values are PUBLIC by design (the anon key only allows what the database security rules allow).
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-KEY
# Your live site address, used for canonical links (no trailing slash).
VITE_SITE_URL=https://www.example.com
# NEVER put the service_role key in any VITE_ variable or in this repository.
